{
  "name": "artic-tempest-website",
  "version": "1.12.6",
  "author": "Zatoshi",
  "description": "Artictempest Project Website",
  "private": true,
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css,md}\"",
    "analyze": "cross-env ANALYZE=true npm run build",
    "analyze:bundle": "npx next experimental-analyze",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:migration:new": "npx supabase migration new",
    "db:status": "npx supabase migration list",
    "prebuild": "node scripts/generate-blur-placeholders.mjs && node scripts/convert-to-webp.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/third-parties": "^16.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "domhandler": "^5.0.3",
    "dompurify": "^3.4.15",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.8",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-selecto": "^1.26.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.5.0",
    "tailwind-animations": "^1.0.2",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/toolbar": "0.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@sentry/cli": true
  },
  "trustedDependencies": [
    "@sentry/cli",
    "unrs-resolver"
  ],
  "overrides": {
    "fast-uri": "^3.1.6",
    "undici": "^8.10.2",
    "es-toolkit": "^1.51.0"
  }
}
